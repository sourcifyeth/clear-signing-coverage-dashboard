# Copy to .env (which is gitignored) and fill in. Never commit real credentials.

# ---- Live path: block follower + API (required) ----------------------------

# JSON-RPC endpoint for Ethereum mainnet. Order of precedence:
#   1. RPC_URL       any endpoint, key included
#   2. DRPC_API_KEY  -> https://lb.drpc.org/ethereum/<key>
#   3. public fallback https://ethereum-rpc.publicnode.com (rate-limited)
# The key and the URL are never logged.
RPC_URL=
DRPC_API_KEY=

# SQLite database file. The follower and the BigQuery stages write to it,
# the API reads from it. Defaults to <repo>/out/coverage.sqlite when unset.
DB_PATH=out/coverage.sqlite

# Local checkout of clear-signing-erc7730-registry (descriptors + index files).
# Defaults to the sibling ../clear-signing-erc7730-registry when unset.
REGISTRY_PATH=../clear-signing-erc7730-registry

# Follower tuning
POLL_MS=4000            # how often to check for a new head, in ms
START_BLOCK=            # first block to process; empty = resume after the stored head
RETENTION_DAYS=7        # prune blocks / tx_index / block_groups older than this
# Sourcify verification sync (runs inside the follower as a background task)
CONTRACTS_SYNC=1        # 0 turns it off
CONTRACTS_BATCH=100     # addresses checked per 30 s round
CONTRACTS_RATE=4        # Sourcify requests per second

# API
PORT=8787
HOST=127.0.0.1          # bind address; loopback only (nginx / Vite sit in front). 0.0.0.0 to expose

# ---- BigQuery path: 24h snapshot and backfill (optional) -------------------

# GCP project that BigQuery query jobs are billed to.
GCP_PROJECT_ID=sourcify-project

# Path to a service-account JSON key with roles/bigquery.jobUser.
# Leave unset on Cloud Run (the attached service account is used automatically).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---- Not used by the code, listed for completeness -------------------------
# QUICKNODE_API_KEY=    # set RPC_URL to your QuickNode endpoint URL instead
# ETHERSCAN_API_KEY=    # no code reads it
