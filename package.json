{
  "name": "clear-signing-coverage-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Dashboard measuring what share of Ethereum transactions can be clear-signed with ERC-7730 descriptors, and which contracts to add next to reach 80% / 95% coverage.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "stage-a": "tsx packages/coverage/src/cli.ts",
    "stage-b": "tsx packages/worker/src/cli.ts",
    "stage-c": "tsx packages/worker/src/cliC.ts",
    "import-json": "tsx packages/worker/src/importJson.ts",
    "follow": "tsx packages/worker/src/follower/follow.ts",
    "signatures:backfill": "tsx packages/worker/src/follower/backfillSignatures.ts",
    "tokens:backfill": "tsx packages/worker/src/follower/backfillTokens.ts",
    "windows:check": "tsx packages/worker/src/follower/checkWindows.ts",
    "api": "tsx packages/api/src/server.ts",
    "web": "npm run dev --workspace apps/web",
    "dev": "npm run api & npm run web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
